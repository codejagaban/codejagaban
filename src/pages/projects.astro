---
import Layout from "../layouts/Layout.astro";
import projects from "../data/projects.json";
import AnimatedShow from "../components/AnimatedShow";

const labelFor = (section: string) => {
  const map: Record<string, string> = {
    "Current Project": "— now",
    "Personal Projects": "— personal",
    "Engineering Projects": "— engineering",
  };
  return map[section] ?? `— ${section.toLowerCase()}`;
};
---

<Layout
  title="Projects by Trust Jamin"
  description="Explore project and community initiatives handled by Trust Jamin"
  keywords="Trust Jamin projects, web development, TypeScript, Next.js, Gatsby, software engineering"
  image="/projects.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load>
        <h1 class="page-h1">Projects</h1>
        <p class="page-lead">
          A collection of things I've built and contributed to, from
          personal experiments to production applications.
        </p>
      </AnimatedShow>

      {
        projects.map((section, i) => (
          <AnimatedShow client:load delay={i * 0.08}>
            <div id={section.section.replace(/\s+/g, "-").toLowerCase()}>
              <h2 class="label">
                {labelFor(section.section)}
                <span class="label-meta">({section.projects.length})</span>
              </h2>

              <ul class="project-list">
                {section.projects.map((project) => (
                  <li class="project">
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-row"
                    >
                      <div class="project-head">
                        <span class="project-name">{project.name}</span>
                        <span class="arrow">↗</span>
                      </div>
                      <p class="project-desc">{project.description}</p>
                      <div class="tech-stack">
                        {project.technologies.slice(0, 6).map((tech: string) => (
                          <span class="tech">{tech}</span>
                        ))}
                        {project.technologies.length > 6 && (
                          <span class="tech tech-more">
                            +{project.technologies.length - 6}
                          </span>
                        )}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </AnimatedShow>
        ))
      }

      <AnimatedShow client:load delay={0.3}>
        <div>
          <h2 class="label">— more code</h2>
          <p class="github-line">
            <a
              href="https://github.com/codejagaban"
              target="_blank"
              rel="noopener noreferrer"
              class="github-link">github.com/codejagaban <span class="arrow">↗</span></a
            >
          </p>
        </div>
      </AnimatedShow>
    </div>
  </section>
</Layout>

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .project {
    border-bottom: 1px dashed var(--color-border);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 0;
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-base);
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
  }

  .project-row:hover .project-name {
    text-decoration: underline;
    text-decoration-color: var(--color-text);
    text-underline-offset: 4px;
  }

  .project-row:hover .arrow {
    transform: translate(2px, -2px);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-top: 0.2rem;
  }

  .tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: lowercase;
    letter-spacing: 0;
  }

  .tech-more {
    color: var(--color-text-subtle);
  }

  .github-line {
    margin: 0;
    max-width: none;
  }

  .github-link {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    transition: color var(--transition-base);
  }

  .github-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  .arrow {
    color: var(--color-text-subtle);
  }

  .project-row:hover .arrow,
  .github-link:hover .arrow {
    color: var(--color-text);
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Projects by Trust Jamin",
    "description": "Explore project and community initiatives handled by Trust Jamin",
    "url": "https://jamin.sh/projects",
    "author": {
      "@type": "Person",
      "name": "Trust Jamin",
      "url": "https://jamin.sh"
    }
  }
</script>
