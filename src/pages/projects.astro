---
import Layout from "../layouts/Layout.astro";
import projects from "../data/projects.json";
import AnimatedShow from "../components/AnimatedShow";

const allProjects = projects.flatMap((section) => section.projects);
---

<Layout
  title="Projects by Trust Jamin"
  description="Explore project and community initiatives handled by Trust Jamin"
  keywords="Trust Jamin projects, web development, TypeScript, Next.js, Gatsby, software engineering"
  image="/projects.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load>
        <h1 class="page-h1">Projects</h1>
        <p class="page-lead">
          A collection of things I've built and contributed to, from
          personal experiments to production applications.
        </p>
      </AnimatedShow>

      <AnimatedShow client:load delay={0.08}>
        <ul class="project-list">
          {
            allProjects.map((project) => (
              <li class="project">
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-row"
                >
                  <div class="project-head">
                    <span class="project-name link-underline">{project.name}</span>
                    <span class="arrow">↗</span>
                  </div>
                  <p class="project-desc">{project.description}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </AnimatedShow>

      <AnimatedShow client:load delay={0.3}>
        <div>
          <h2 class="label">— more code</h2>
          <p class="github-line">
            <a
              href="https://github.com/codejagaban"
              target="_blank"
              rel="noopener noreferrer"
              class="github-link link-underline">github.com/codejagaban <span class="arrow">↗</span></a
            >
          </p>
        </div>
      </AnimatedShow>
    </div>
  </section>
</Layout>

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .project {
    border-bottom: 1px dashed var(--color-border);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-row-lg) 0;
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-base);
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .project-name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
  }

  /* The whole row is the target, so the name's rule answers a hover anywhere
     in it rather than only over the words themselves. */
  .project-row:hover .link-underline,
  .project-row:focus-visible .link-underline {
    background-size: 100% 1px, 100% 1px;
    background-position: left 0 bottom 0, left 0 bottom 0;
  }

  .project-row:hover .arrow {
    transform: translate(2px, -2px);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
    max-width: none;
  }

  .github-line {
    margin: 0;
    max-width: none;
  }

  .github-link {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    transition: color var(--transition-base);
  }

  .github-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  .arrow {
    color: var(--color-text-subtle);
  }

  .project-row:hover .arrow,
  .github-link:hover .arrow {
    color: var(--color-text);
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Projects by Trust Jamin",
    "description": "Explore project and community initiatives handled by Trust Jamin",
    "url": "https://jamin.sh/projects",
    "author": {
      "@type": "Person",
      "name": "Trust Jamin",
      "url": "https://jamin.sh"
    }
  }
</script>
