---
import Layout from "../layouts/Layout.astro";
import { posts } from "../data/blog.json";
import AnimatedShow from "../components/AnimatedShow";

interface Post {
  title: string;
  link: string;
  date: string;
  company?: string;
}

const postsByYear: Record<string, Post[]> = {};
posts.forEach((post: Post) => {
  if (!postsByYear[post.date]) {
    postsByYear[post.date] = [];
  }
  postsByYear[post.date].push(post);
});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout
  title="Blog posts and articles written by Trust Jamin"
  description="Explore technical articles and blog posts crafted by Trust Jamin Okpukoro"
  keywords="Trust Jamin, Trust Jamin Okpukoro, technology insights, programming articles, software development blog, web development, TypeScript, Node.js"
  image="/blog.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load>
        <h1 class="page-h1">Writing</h1>
        <p class="page-lead">
          {posts.length} articles across {years.length} years. Tutorials, guides,
          and the occasional bug-fix story.
        </p>
      </AnimatedShow>

      {
        years.map((year, yearIndex) => (
          <AnimatedShow client:load delay={yearIndex * 0.05}>
            <div id={`year-${year}`}>
              <h2 class="label">
                — {year}
                <span class="label-meta">({postsByYear[year].length})</span>
              </h2>
              <ul class="link-list">
                {postsByYear[year].map((post) => (
                  <li>
                    <a
                      href={post.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="row"
                    >
                      <span class="row-title">{post.title}</span>
                      {post.company && (
                        <span class="row-meta">
                          {post.company}
                          <span class="arrow">↗</span>
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </AnimatedShow>
        ))
      }
    </div>
  </section>
</Layout>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Blog posts and articles written by Trust Jamin",
    "description": "Explore technical articles and blog posts crafted by Trust Jamin Okpukoro",
    "url": "https://jamin.sh/blog",
    "author": {
      "@type": "Person",
      "name": "Trust Jamin Okpukoro",
      "url": "https://jamin.sh"
    }
  }
</script>

<script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@graph": posts.map((p) => ({
      "@type": "Article",
      "headline": p.title,
      "url": p.link,
      "datePublished": p.date,
      "author": { "@type": "Person", "name": "Trust Jamin" },
      "publisher": p.company ? { "@type": "Organization", "name": p.company } : { "@type": "Person", "name": "Trust Jamin" }
    }))
  })}
</script>
