---
import Layout from "../layouts/Layout.astro";
import data from "../data/talks.json";
import AnimatedShow from "../components/AnimatedShow";
---

<Layout
  title="Talks, Conferences and events Trust Jamin has spoken at"
  description="Explore talks and events crafted by Trust Jamin"
  keywords="Trust Jamin talks, speaking opportunities, conferences, DevRel, TypeScript, Node.js"
  image="/talks.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load>
        <h1 class="page-h1">Speaking</h1>
        <p class="page-lead">
          I speak at conferences and meetups about developer experience,
          technical writing, and web technologies.
        </p>
      </AnimatedShow>

      <AnimatedShow client:load stagger delay={0.1} className="stack">
        <div>
          <h2 class="label">— talks</h2>
          <ul class="talks-list">
            {
              data.map((talk) => (
                <li class="talk">
                  <div class="talk-head">
                    <h3 class="talk-title">{talk.title}</h3>
                    <span class="talk-date">{talk.date}</span>
                  </div>
                  <div class="talk-meta">
                    <a
                      href={talk.confLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="conf"
                    >
                      {talk.confName} <span class="arrow">↗</span>
                    </a>
                    {talk.slide && (
                      <a
                        href={talk.slide}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="slides"
                      >
                        slides <span class="arrow">↗</span>
                      </a>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="label">— want me at your event?</h2>
          <p class="invite">
            <a
              href="mailto:hellotsjamin@gmail.com"
              class="invite-link">hellotsjamin@gmail.com <span class="arrow">↗</span></a
            >
          </p>
        </div>
      </AnimatedShow>
    </div>
  </section>
</Layout>

<style>
  .talks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .talk {
    padding: 0.85rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .talk:last-child {
    border-bottom: none;
  }

  .talk-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .talk-title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
    flex: 1;
    min-width: 0;
    letter-spacing: -0.01em;
  }

  .talk-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .talk-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: 0.3rem;
  }

  .conf,
  .slides {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    transition: color var(--transition-base);
  }

  .conf:hover,
  .slides:hover {
    color: var(--color-text);
  }

  .conf:hover .arrow,
  .slides:hover .arrow {
    transform: translate(2px, -2px);
  }

  .invite {
    margin: 0;
    max-width: none;
  }

  .invite-link {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    transition: color var(--transition-base);
  }

  .invite-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 540px) {
    .talk-head {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Talks, Conferences and events Trust Jamin has spoken at",
    "description": "Explore talks and events crafted by Trust Jamin",
    "url": "https://jamin.sh/talks",
    "author": {
      "@type": "Person",
      "name": "Trust Jamin",
      "url": "https://jamin.sh"
    }
  }
</script>
