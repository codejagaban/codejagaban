---
import Layout from "../layouts/Layout.astro";
import AnimatedShow from "../components/AnimatedShow";

const skills = [
  {
    label: "development",
    items: "Node.js, Next.js, React.js, Astro, TypeScript, JavaScript, GoLang, GraphQL",
  },
  {
    label: "infrastructure",
    items: "Docker, AWS, PostgreSQL, MySQL, MongoDB",
  },
  {
    label: "devrel & writing",
    items: "Technical writing, API documentation, community building, content strategy",
  },
  {
    label: "ai & agentic workflows",
    items: "LLMs, prompt engineering, AI agents, RAG, LangChain, OpenAI",
  },
];

const platforms = [
  {
    name: "Uploadcare",
    desc: "Developer tutorials & guides",
    link: "https://uploadcare.com/blog/author/trust-jamin/",
  },
  {
    name: "Directus",
    desc: "CMS integrations & tutorials",
    link: "https://docs.directus.io/blog/",
  },
  {
    name: "Apify",
    desc: "Web scraping & automation",
    link: "https://blog.apify.com/author/jamin/",
  },
  {
    name: "Personal blog",
    desc: "General tech insights",
    link: "https://blog.jamin.sh/",
  },
  {
    name: "Dev.to",
    desc: "Community articles",
    link: "https://dev.to/codejagaban",
  },
  {
    name: "OpenReplay",
    desc: "Frontend development",
    link: "https://blog.openreplay.com/authors/trust-jamin",
  },
];

const community = [
  { role: "Co-founder", org: "Community Leads Africa" },
  { role: "DevRel Community Lead", org: "Polygon Guild Lagos" },
  { role: "Community Manager", org: "Notion Lagos" },
  { role: "Champion", org: "Twilio" },
  { role: "Organizer", org: "GDG Sapele" },
];
---

<Layout
  title="About Trust Jamin Okpukoro"
  description="Learn about Trust Jamin Okpukoro's projects, technical articles, community management endeavors, involvements in open source projects and pieces of information about him."
  keywords="Trust Jamin, Trust Okpukoro, Trust Jamin Okpukoro, developer advocate, open source, technical Writing, community engagement, DevRel"
  image="/about.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load>
        <div class="lede">
          <h1 class="page-h1">About</h1>
          <p class="page-lead">
            Software engineer with years of experience building products that
            run on the web.
          </p>

          <div class="prose">
            <p>
              Lately, you'll find me writing tutorials, documentation, or
              occasionally about a bug I just fixed. Anything that helps
              developers ship better with modern tools.
            </p>
            <p>
              I believe constant learning is the catalyst for personal and
              professional growth. Adapting to change, overcoming challenges,
              unlocking potential. I'm always working on the finest version of
              myself.
            </p>
            <p>
              Currently focused on <em>agentic engineering</em> and intelligent
              <em>AI workflows</em>.
            </p>
          </div>
        </div>
      </AnimatedShow>

      <AnimatedShow client:load stagger delay={0.15} className="stack">
        <div>
          <h2 class="label">— skills</h2>
          <ul class="skill-list">
            {
              skills.map((s) => (
                <li>
                  <span class="skill-label">{s.label}</span>
                  <span class="skill-items">{s.items}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="label">— writing on</h2>
          <ul class="link-list">
            {
              platforms.map((p) => (
                <li>
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row"
                  >
                    <span class="row-title">{p.name}</span>
                    <span class="row-meta">
                      {p.desc}
                      <span class="arrow">↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="label">— community</h2>
          <ul class="link-list">
            {
              community.map((c) => (
                <li>
                  <div class="row">
                    <span class="row-title">{c.org}</span>
                    <span class="row-meta">{c.role}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="label">— say hi</h2>
          <p class="contact">
            <a
              href="mailto:hellotsjamin@gmail.com"
              class="contact-link">hellotsjamin@gmail.com <span class="arrow">↗</span></a
            >
          </p>
        </div>
      </AnimatedShow>
    </div>
  </section>
</Layout>

<style>
  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .skill-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .skill-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: lowercase;
  }

  .skill-items {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.75;
  }

  .contact {
    margin: 0;
    max-width: none;
  }

  .contact-link {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    transition: color var(--transition-base);
  }

  .contact-link:hover .arrow {
    transform: translate(2px, -2px);
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Trust Jamin Okpukoro",
    "url": "https://jamin.sh",
    "jobTitle": "Senior Technical Writer and Developer Advocate",
    "description": "Senior software engineer, technical writer, and developer advocate focused on building developer-first content, tools, and communities.",
    "sameAs": [
      "https://www.linkedin.com/in/codejagaban",
      "https://github.com/codejagaban",
      "https://dev.to/codejagaban",
      "https://twitter.com/codejagaban"
    ]
  }
</script>

<script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How can I contact Trust Jamin?",
        "acceptedAnswer": { "@type": "Answer", "text": "Email: hellotsjamin@gmail.com" }
      },
      {
        "@type": "Question",
        "name": "What topics does he write about?",
        "acceptedAnswer": { "@type": "Answer", "text": "Developer tooling, file uploads, image optimization, Astro, Directus, and devrel topics." }
      },
      {
        "@type": "Question",
        "name": "Where can I find his other writing?",
        "acceptedAnswer": { "@type": "Answer", "text": "See the writing section for links to Uploadcare, Directus, Apify, Dev.to, and personal blog posts." }
      }
    ]
  })}
</script>
