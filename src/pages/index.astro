---
import Layout from "../layouts/Layout.astro";
import AnimatedShow from "../components/AnimatedShow";
import blogData from "../data/blog.json";
import projectsData from "../data/projects.json";
import talksData from "../data/talks.json";

const recentPosts = blogData.posts.slice(0, 5);
const recentTalks = talksData.slice(0, 3);
const engineering =
  projectsData.find((p) => p.section === "Engineering Projects")?.projects ?? [];
const workCompanies = ["Uploadcare", ...engineering.map((p) => p.name)];
---

<Layout
  title="Trust Jamin Okpukoro – Senior Technical Writer & Developer Advocate"
  description="Trust Jamin Okpukoro is a senior software engineer, technical writer, and developer advocate focused on building developer-first content, tools, and communities."
  keywords="developer advocate, technical writer, DevRel, Trust Jamin, Trust Okpukoro, open source, API documentation, developer communities"
  image="/image.png"
>
  <section class="page">
    <div class="column">
      <AnimatedShow client:load stagger>
        <div>
          <h1 class="page-h1">Trust Jamin</h1>
          <p class="role">Software engineer &amp; developer advocate.</p>
        </div>

        <div class="prose intro">
          <p>
            I bridge the gap between developers and technology, building
            <a href="/projects">solutions</a>, writing
            <a href="/blog">documentation</a>, and contributing to
            <a
              href="https://github.com/codejagaban"
              target="_blank"
              rel="noopener noreferrer">open source</a
            >.
          </p>
          <p>
            Currently exploring <em>agentic engineering</em> and intelligent
            <em>AI workflows</em>.
          </p>
        </div>

        <div>
          <h2 class="label">— now</h2>
          <ul class="bullets">
            <li>Senior technical writer at Uploadcare.</li>
            <li>Speaking at CityJS London 2026.</li>
            <li>
              Building <a
                href="https://www.invoicer.cv/"
                target="_blank"
                rel="noopener noreferrer">Invoicer</a
              > on the side.
            </li>
          </ul>
        </div>

        <div>
          <h2 class="label">— writing</h2>
          <ul class="link-list">
            {
              recentPosts.map((post) => (
                <li>
                  <a
                    href={post.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row"
                  >
                    <span class="row-title">{post.title}</span>
                    <span class="row-meta">
                      {post.company}
                      <span class="arrow">↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/blog" class="more">all writing →</a>
        </div>

        <div>
          <h2 class="label">— talks</h2>
          <ul class="link-list">
            {
              recentTalks.map((talk) => (
                <li>
                  <a
                    href={talk.confLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row"
                  >
                    <span class="row-title">{talk.title}</span>
                    <span class="row-meta">
                      {talk.confName}
                      <span class="arrow">↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/talks" class="more">all talks →</a>
        </div>

        <div>
          <h2 class="label">— work</h2>
          <p class="work-list">{workCompanies.join(" · ")}</p>
          <a href="/projects" class="more">all projects →</a>
        </div>

        <div>
          <h2 class="label">— elsewhere</h2>
          <ul class="socials">
            <li>
              <a
                href="https://github.com/codejagaban"
                target="_blank"
                rel="noopener noreferrer">github <span class="arrow">↗</span></a
              >
            </li>
            <li>
              <a
                href="https://x.com/codejagaban"
                target="_blank"
                rel="noopener noreferrer">twitter <span class="arrow">↗</span></a
              >
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/codejagaban/"
                target="_blank"
                rel="noopener noreferrer">linkedin <span class="arrow">↗</span></a
              >
            </li>
            <li>
              <a href="mailto:hellotsjamin@gmail.com">email</a>
            </li>
          </ul>
        </div>
      </AnimatedShow>
    </div>
  </section>
</Layout>

<style>
  .role {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    margin-bottom: 0;
  }

  .intro {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bullets li {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
  }

  .bullets a {
    color: var(--color-text);
    text-decoration-color: var(--color-border-hover);
  }

  .work-list {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
    max-width: none;
  }

  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .socials a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    transition: color var(--transition-base);
  }

  .socials a:hover {
    color: var(--color-text);
  }

  .socials .arrow {
    font-size: var(--text-xs);
  }

  .socials a:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 540px) {
    .page-h1 {
      font-size: var(--text-2xl);
    }
  }
</style>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Trust Jamin",
    "url": "https://www.jamin.sh",
    "jobTitle": "Technical Writer and Developer Advocate",
    "sameAs": [
      "https://www.linkedin.com/in/codejagaban",
      "https://github.com/codejagaban",
      "https://dev.to/codejagaban",
      "https://twitter.com/codejagaban",
      "https://blog.jamin.sh"
    ],
    "description": "Trust Jamin is a senior software engineer, technical writer, and developer advocate focused on building developer-first content, tools, and communities."
  }
</script>
